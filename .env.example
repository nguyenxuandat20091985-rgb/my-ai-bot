# ============================================================
# MY AI AFFILIATE AGENT V1.0 - Environment Variables
# Copy to .env and fill values. NEVER commit .env
# ============================================================

# Required (already used by Core)
GROQ_API_KEY=your_groq_key_here

# Optional – AccessTrade (REQUIRES OFFICIAL DOCS + ACCOUNT)
ACCESSTRADE_API_KEY=
ACCESSTRADE_API_TOKEN=
ACCESSTRADE_PUBLISHER_ID=
# ACCESSTRADE_BASE_URL=https://api.accesstrade.vn

# Safety & Publish control
SAFE_MODE=true
AUTO_PUBLISH=false

# Quality thresholds (0-100)
MIN_FACT_SCORE=70
MIN_QUALITY_SCORE=65
MIN_SEO_SCORE=60
MIN_SAFETY_SCORE=80

# Optional
AI_MODEL=groq/llama-3.3-70b-versatile
AI_TEMPERATURE=0.7
BLOG_URL=https://nguyenxuandat20091985-rgb.github.io/my-ai-bot
LOG_LEVEL=INFO
ENABLE_IMAGE_GEN=false
ENABLE_SOCIAL_PUBLISH=false